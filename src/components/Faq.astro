---
import Icon from './Icon.astro';

/** Renders a list of FAQ items as a native <details> accordion + optional FAQPage JSON-LD. */
interface FaqItem {
  q: string;
  a: string; // plain text answer (used for JSON-LD); HTML allowed in item bodies below
  aHtml?: string;
}
interface Props {
  items: FaqItem[];
  schema?: boolean; // emit FAQPage JSON-LD
  idPrefix?: string;
}
const { items, schema = true, idPrefix = 'faq' } = Astro.props;

const jsonLd = schema
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: items.map((it) => ({
        '@type': 'Question',
        name: it.q,
        acceptedAnswer: { '@type': 'Answer', text: it.a },
      })),
    }
  : null;
---
<div class="faq-list">
  {
    items.map((it, i) => (
      <details class="faq-item" id={`${idPrefix}-${i}`}>
        <summary>
          <Icon name="help" size={19} />
          <span>{it.q}</span>
        </summary>
        <div class="faq-body">{it.aHtml ? <Fragment set:html={it.aHtml} /> : <p>{it.a}</p>}</div>
      </details>
    ))
  }
</div>
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
