---
/**
 * Decorative medieval divider: line ◆ ◆ ◆ line - drawn as inline SVG
 * fleurons so it never falls back to platform emoji fonts.
 */
---
<div class="ornament" aria-hidden="true">
  <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" class="orn-diamond">
    <path d="M12 5l5 7-5 7-5-7z" />
  </svg>
  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="orn-diamond orn-center">
    <path d="M12 2.5l6.5 9.5-6.5 9.5L5.5 12z" />
    <path d="M12 8.5l2.8 3.5-2.8 3.5-2.8-3.5z" fill="var(--parchment)" />
  </svg>
  <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" class="orn-diamond">
    <path d="M12 5l5 7-5 7-5-7z" />
  </svg>
</div>
